---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Tree Service Area | Westchester County & Lower Connecticut"
  description="Ecology Tree Service is based in Mount Kisco and serves properties across Westchester County and Lower Connecticut. Call to confirm availability."
  contentPrefix="serviceArea"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Service Area', path: '/service-area/' }]}
>
  <section class="page-hero"><div class="shell"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Service Area</span></nav><p class="eyebrow" style="margin-top:2rem">Regional reach</p><h1 data-content-key="serviceArea.hero.heading">Tree service from Mount Kisco.</h1><p class="lead" data-content-key="serviceArea.hero.lead">We’re based in Mount Kisco and work across Westchester County and Lower Connecticut. Call with your property location to confirm availability and scheduling.</p><a class="button" href="tel:+19147609892">Confirm Your Location</a></div></section>
  <section class="section section-white"><div class="shell area-grid"><div class="area-map" aria-hidden="true"><div class="map-pin"><span>Mount<br/>Kisco</span></div></div><div><p class="section-label">Mount Kisco base</p><h2 data-content-key="serviceArea.body.heading">Serving the region on both sides of the state line.</h2><p class="lead">Our primary service areas are:</p><ul class="area-list"><li>Westchester County</li><li>Lower Connecticut</li></ul><p data-content-key="serviceArea.body.copy">Service availability varies by project, crew schedule, travel distance, and site conditions. Call the office at (914) 242-9892 or the cell at (914) 760-9892 to confirm your location.</p></div></div></section>
  <section class="section quote"><div class="narrow"><p class="eyebrow">Regional contact</p><h2 data-content-key="serviceArea.cta.heading">Tell us where the tree is.</h2><p class="lead" data-content-key="serviceArea.cta.lead">The property location, tree concern, and a safe photo if available are a useful place to start.</p><div class="hero-actions"><a class="button" href="tel:+19147609892">Call Cell (914) 760-9892</a><a class="button button-secondary" href="mailto:info@ecologytreeservice.com?subject=Service%20area%20question">Email Us</a></div></div></section>
</BaseLayout>
