---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
---
<BaseLayout
  title="Request a Tree Service Estimate | Ecology Tree Service"
  description="Request a pruning, removal, storm-damage, stump-grinding or tree-planting estimate from Ecology Tree Service in Mount Kisco."
>
  <section class="section quote estimate-page">
    <div class="shell estimate-grid">
      <div class="estimate-copy">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Estimate</span></nav>
        <p class="eyebrow estimate-eyebrow">Request an estimate</p>
        <h1>Tell us what the property needs.</h1>
        <p class="lead">A few practical details help us understand the tree, access, timing, and the best way to follow up.</p>
        <div class="estimate-direct">
          <span>Prefer to talk?</span>
          <a href="tel:+19142429892">Office (914) 242-9892</a>
          <a href="tel:+19147609892">Cell (914) 760-9892</a>
          <small>Never touch a downed wire or anything it may be energizing—even if the wire appears to be cable or telephone. Contact the utility and emergency services first.</small>
        </div>
      </div>
      <QuoteForm />
    </div>
  </section>
</BaseLayout>
