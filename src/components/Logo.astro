---
import { Image } from 'astro:assets';
import ecologyLogo from '../assets/ecology-logo.png';

interface Props { light?: boolean; }
const { light = false } = Astro.props;
---
<a class:list={["brand", { light }]} href="/" aria-label="Ecology Tree Service, Inc. home">
  <Image
    class="brand-logo"
    src={ecologyLogo}
    alt="Ecology Tree Service, Inc."
    widths={[64, 128, 256]}
    sizes={light ? "128px" : "64px"}
    format="webp"
    quality={88}
    loading={light ? "lazy" : "eager"}
    decoding="async"
  />
</a>

<style>
  .brand { display: inline-flex; align-items: center; flex: 0 0 auto; text-decoration: none; }
  .brand-logo { width: 4rem; height: auto; }
  .brand.light { padding: .7rem; background: var(--paper); }
  .brand.light .brand-logo { width: 8rem; }

  @media (max-width: 640px) {
    .brand-logo { width: 3.55rem; }
  }
</style>
