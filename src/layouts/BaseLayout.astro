---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  contentPrefix?: string;
}

const {
  title,
  description,
  image = '/og-image.jpg',
  imageAlt = 'Ecology Tree Service logo beside arborists working in a mature tree',
  noindex = false,
  breadcrumbs = [],
  contentPrefix
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const showFullAddress = Astro.url.pathname.replace(/\/+$/, '') === '/about';
const localBusiness = {
  '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
  '@id': 'https://ecologytreeservice.com/#business',
  name: 'Ecology Tree Service, Inc.',
  alternateName: 'Ecology Tree Care',
  url: 'https://ecologytreeservice.com',
  telephone: ['+1-914-242-9892', '+1-914-760-9892'],
  email: 'info@ecologytreeservice.com',
  foundingDate: '1996',
  image: 'https://ecologytreeservice.com/og-image.jpg',
  logo: {
    '@type': 'ImageObject',
    url: 'https://ecologytreeservice.com/apple-touch-icon.png',
    width: 180,
    height: 180
  },
  address: showFullAddress ? {
    '@type': 'PostalAddress',
    streetAddress: '215 Croton Lake Road',
    addressLocality: 'Mount Kisco',
    addressRegion: 'NY',
    postalCode: '10549',
    addressCountry: 'US'
  } : {
    '@type': 'PostalAddress',
    addressLocality: 'Mount Kisco',
    addressRegion: 'NY',
    addressCountry: 'US'
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Westchester County, New York' },
    { '@type': 'AdministrativeArea', name: 'Lower Connecticut' }
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+1-914-242-9892',
      contactType: 'office',
      areaServed: ['US-NY', 'US-CT'],
      availableLanguage: 'English'
    },
    {
      '@type': 'ContactPoint',
      telephone: '+1-914-760-9892',
      contactType: 'customer service',
      areaServed: ['US-NY', 'US-CT'],
      availableLanguage: 'English'
    }
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Professional tree services',
    itemListElement: [
      ['Tree Pruning', 'tree-pruning'],
      ['Tree Removal', 'tree-removal'],
      ['Storm-Damaged Tree Work', 'storm-damage'],
      ['Stump Grinding', 'stump-grinding'],
      ['Tree Planting', 'tree-planting']
    ].map(([name, slug]) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name,
        url: `https://ecologytreeservice.com/services/${slug}/`
      }
    }))
  },
  knowsAbout: [
    'tree pruning',
    'crown thinning',
    'tree cabling and bracing',
    'tree removal',
    'crane-assisted tree removal',
    'storm-damaged trees',
    'stump grinding',
    'tree planting'
  ],
  priceRange: '$$'
};

const website = {
  '@type': 'WebSite',
  '@id': 'https://ecologytreeservice.com/#website',
  url: 'https://ecologytreeservice.com/',
  name: 'Ecology Tree Service',
  alternateName: 'Ecology Tree Service, Inc.',
  inLanguage: 'en-US',
  publisher: { '@id': 'https://ecologytreeservice.com/#business' }
};

const webPage = {
  '@type': 'WebPage',
  '@id': `${canonical.href}#webpage`,
  url: canonical.href,
  name: title,
  description,
  inLanguage: 'en-US',
  isPartOf: { '@id': 'https://ecologytreeservice.com/#website' },
  about: { '@id': 'https://ecologytreeservice.com/#business' },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: ogImage.href,
    caption: imageAlt
  }
};

const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@type': 'BreadcrumbList',
  '@id': `${canonical.href}#breadcrumb`,
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(item.path, Astro.site).href
  }))
} : null;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [localBusiness, website, webPage, ...(breadcrumbSchema ? [breadcrumbSchema] : [])]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title data-content-key={contentPrefix ? `${contentPrefix}.seo.title` : undefined}>{title}</title>
    <meta name="description" content={description} data-content-key={contentPrefix ? `${contentPrefix}.seo.description` : undefined} data-content-attr="content" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#193b2a" />
    <meta name="format-detection" content="telephone=yes" />
    <meta
      name="robots"
      content={noindex
        ? 'noindex,follow'
        : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ecology Tree Service" />
    <meta property="og:title" content={title} data-content-key={contentPrefix ? `${contentPrefix}.seo.title` : undefined} data-content-attr="content" />
    <meta property="og:description" content={description} data-content-key={contentPrefix ? `${contentPrefix}.seo.description` : undefined} data-content-attr="content" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} data-content-key={contentPrefix ? `${contentPrefix}.seo.title` : undefined} data-content-attr="content" />
    <meta name="twitter:description" content={description} data-content-key={contentPrefix ? `${contentPrefix}.seo.description` : undefined} data-content-attr="content" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer showFullAddress={showFullAddress} />
    <nav class="mobile-actions" aria-label="Quick contact">
      <a href="tel:+19147609892"><small>Talk to the team</small><strong>Call cell</strong></a>
      <a href="/estimate"><small>Describe the job</small><strong>Request quote</strong></a>
    </nav>
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        const parallax = document.querySelectorAll<HTMLElement>('[data-parallax]');
        let ticking = false;
        const update = () => {
          const y = window.scrollY;
          parallax.forEach((item) => {
            const speed = Number(item.dataset.parallax || .12);
            item.style.setProperty('--parallax-y', `${Math.min(y * speed, 120)}px`);
          });
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) { requestAnimationFrame(update); ticking = true; }
        }, { passive: true });
      }
    </script>
    <script is:inline>
      (() => {
        if (location.hostname !== 'ecologytreeservice.com' && location.hostname !== 'www.ecologytreeservice.com') return;
        if (navigator.doNotTrack === '1') return;
        const payload = JSON.stringify({
          path: location.pathname,
          referrer: document.referrer,
          screenWidth: Math.round(window.innerWidth / 100) * 100
        });
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/analytics/view', new Blob([payload], { type: 'application/json' }));
        } else {
          fetch('/api/analytics/view', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true }).catch(() => {});
        }
      })();
    </script>
  </body>
</html>
